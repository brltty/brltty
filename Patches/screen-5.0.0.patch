+/* export ipc image */
+extern int color256to16(int);
+
+static int
+DecodeColor(uint32_t color, int is_bg)
+{
+	static const unsigned char tr[] = {
+		0X0, 0X4, 0X2, 0X6, 0X1, 0X5, 0X3, 0X7,
+		0X8, 0XC, 0XA, 0XE, 0X9, 0XD, 0XB, 0XF
+	};
+
+	if (color == 0)
+		return is_bg ? 0 : 7; /* Default: Black (0) for bg, Light Gray (7) for fg */
+
+	if ((color & 0xFF000000) == 0x01000000) {
+		/* ANSI 16 colors (0-15) */
+		return tr[color & 0x0F];
+	}
+
+	if ((color & 0xFF000000) == 0x02000000) {
+		/* 256 colors */
+		int c = color & 0xFF;
+		if (c < 16)
+			return tr[c & 0x0F];
+		return tr[color256to16(c) & 0x0F];
+	}
+
+	if ((color & 0xFF000000) == 0x04000000) {
+		/* Truecolor */
+		uint8_t r = (color >> 16) & 0xFF;
+		uint8_t g = (color >> 8) & 0xFF;
+		uint8_t b = color & 0xFF;
+		int ansi = 0;
+		if (r >= 128) ansi |= 1;
+		if (g >= 128) ansi |= 2;
+		if (b >= 128) ansi |= 4;
+		if (r >= 192 || g >= 192 || b >= 192) ansi |= 8;
+		return tr[ansi & 0x0F];
+	}
+
+	return is_bg ? 0 : 7;
+}
+
+void
+SetWinImage(const char *msg, unsigned char *dest)
+{
+	unsigned char *d;
+	size_t count = 80 * 1;
+	size_t len;
+
+	if (!dest)
+		return;
+
+	d = dest;
+	len = msg ? strlen(msg) : 0;
+	if (len > count)
+		len = count;
+
+	*d++ = 80;   /* screen width */
+	*d++ = 1;    /* screen height */
+	*d++ = 0;    /* cursor column */
+	*d++ = 0;    /* cursor row */
+
+	memset(d, ' ', count);
+	if (len > 0)
+		memcpy(d, msg, len);
+	d += count;
+
+	memset(d, 0x07, count);
+	d += count;
+
+	*d++ = 0;    /* window number */
+	*d++ = 0;    /* flags */
+}
+
+void
+CopyWinImage(Window *p, unsigned char *dest)
+{
+	unsigned char *d;
+	int x, y;
+	Display *disp;
+	int st, in, extra;
+	int w, h, total_rows;
+	int cx, cy;
+
+	if (!dest)
+		return;
+
+	if (!p || !p->w_mlines) {
+		SetWinImage("no active screen", dest);
+		return;
+	}
+
+	d = dest;
+	disp = p->w_lastdisp;
+	st = (disp && disp->d_status) ? 1 : 0;
+	in = IsInputLayer(p->w_savelayer) ? 1 : 0;
+	extra = (st || in) ? 1 : 0;
+
+	w = p->w_width;
+	if (w < 0)
+		w = 0;
+	else if (w > 132)
+		w = 132;
+
+	h = p->w_height;
+	if (h < 0)
+		h = 0;
+	if (h + extra > 66)
+		h = 66 - extra;
+	if (h < 0)
+		h = 0;
+
+	total_rows = h + extra;
+
+	if (st)
+		cx = disp->d_status_len;
+	else if (in)
+		cx = GetInputPosition(p->w_savelayer);
+	else
+		cx = p->w_x;
+
+	if (st || in)
+		cy = h;
+	else
+		cy = p->w_y;
+
+	if (w > 0) {
+		if (cx < 0)
+			cx = 0;
+		else if (cx >= w)
+			cx = w - 1;
+	} else {
+		cx = 0;
+	}
+
+	if (total_rows > 0) {
+		if (cy < 0)
+			cy = 0;
+		else if (cy >= total_rows)
+			cy = total_rows - 1;
+	} else {
+		cy = 0;
+	}
+
+	*d++ = (unsigned char)w;
+	*d++ = (unsigned char)total_rows;
+	*d++ = (unsigned char)cx;
+	*d++ = (unsigned char)cy;
+
+	/* copy window image to buffer */
+	for (y = 0; y < h; y++) {
+		uint32_t *s = p->w_mlines[y].image;
+		for (x = 0; x < w; x++) {
+			uint32_t ch = s ? s[x] : ' ';
+			*d++ = (ch < 256) ? (unsigned char)ch : (unsigned char)' ';
+		}
+	}
+
+	/* copy status line to buffer */
+	if (st) {
+		const char *s = disp->d_status_lastmsg;
+		for (x = 0; s && *s && x < w; x++)
+			*d++ = (unsigned char)*s++;
+		for (; x < w; x++)
+			*d++ = ' ';
+	} else if (in) {
+		CopyInputLine(p->w_savelayer, (char *)d, w);
+		d += w;
+	}
+
+	/* copy attributes from window image to buffer */
+	for (y = 0; y < h; y++) {
+		struct mline *ml = &p->w_mlines[y];
+		for (x = 0; x < w; x++) {
+			uint32_t raw_fg = (ml->colorfg && ml->colorfg != null) ? ml->colorfg[x] : 0;
+			uint32_t raw_bg = (ml->colorbg && ml->colorbg != null) ? ml->colorbg[x] : 0;
+			uint32_t at = (ml->attr && ml->attr != null) ? ml->attr[x] : 0;
+
+			int fg = DecodeColor(raw_fg, 0);
+			int bg = DecodeColor(raw_bg, 1);
+
+			if (at & A_BD)
+				fg |= 0x08;
+
+			if (at & (A_RV | A_SO)) {
+				int tmp = fg;
+				fg = bg;
+				bg = tmp;
+			}
+
+			unsigned char attr_byte = (fg & 0x0F) | ((bg & 0x07) << 4);
+			if (at & A_BL)
+				attr_byte |= 0x80;
+
+			*d++ = attr_byte;
+		}
+	}
+
+	if (st || in) {
+		memset(d, (st ? 0x70 : 0x07), w);
+		d += w;
+	}
+
+	*d++ = (unsigned char)p->w_number;
+
+	*d = 0;
+	if (p->w_cursorkeys) *d |= 0x01;
+	if (p->w_keypad)     *d |= 0x02;
+	d++;
+}
+/* end export ipc image */
+
