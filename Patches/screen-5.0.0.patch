+/* add export ipc shared image */
+int
+IsInputLayer(Layer *l)
+{
+	return l && l->l_layfn == &InpLf;
+}
+
+int
+GetInputPosition(Layer *l)
+{
+	struct inpdata *inpdata;
+	if (!l || !l->l_data)
+		return 0;
+	inpdata = (struct inpdata *)l->l_data;
+	return inpdata->inpstringlen + inpdata->inp.pos;
+}
+
+void
+CopyInputLine(Layer *l, char *dest, int width)
+{
+	struct inpdata *inpdata;
+	char *src;
+	int len;
+
+	if (!dest || width <= 0)
+		return;
+
+	if (!l || !l->l_data) {
+		memset(dest, ' ', width);
+		return;
+	}
+
+	inpdata = (struct inpdata *)l->l_data;
+
+	for (src = inpdata->inpstring, len = inpdata->inpstringlen;
+	     width && len;
+	     *dest++ = *src++, len--, width--);
+
+	if (!(inpdata->inpmode & INP_NOECHO)) {
+		for (src = inpdata->inp.buf, len = inpdata->inp.len;
+		     width && len;
+		     *dest++ = *src++, len--, width--);
+	}
+
+	while (width) *dest++ = ' ', width--;
+}
