+/* export ipc image */
+static void InitShm(void)
+{
+	const char *path;
+	key_t key;
+	int shmid;
+
+	/* allow for the header, text, attributes, and auxiliary data
+	 * (assuming no screen will be bigger than 132x66)
+	 */
+	size_t size = 18000;
+
+	path = getenv("HOME");
+	if (!path || !*path)
+		path = "/";
+	if ((key = ftok(path, 'b')) == -1)
+		key = 0XBACD072F;
+
+	shmid = shmget(key, size, IPC_CREAT | S_IRWXU);
+	if (shmid < 0 && errno == EINVAL) {
+		/* Stale segment with different size exists; attempt cleanup and retry */
+		int old_id = shmget(key, 0, 0);
+		if (old_id >= 0) {
+			shmctl(old_id, IPC_RMID, NULL);
+			shmid = shmget(key, size, IPC_CREAT | S_IRWXU);
+		}
+	}
+
+	if (shmid < 0) {
+		Msg(errno, "BRLTTY: shmget failed");
+		return;
+	}
+
+	shm = shmat(shmid, 0, 0);
+	if (shm == (void *)-1) {
+		Msg(errno, "BRLTTY: shmat failed");
+		shm = NULL;
+		return;
+	}
+
+	/* put valid data into the image */
+	SetWinImage("screen is initializing...", shm);
+}
+/* end export ipc image */
+
